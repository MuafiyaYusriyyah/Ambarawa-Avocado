# Salin file ini menjadi secrets.toml (jangan diunggah ke GitHub).
# Di Streamlit Community Cloud, isi bagian yang sama lewat menu Settings > Secrets.

# Login (pilih salah satu, atau hapus keduanya bila dipakai sendiri di komputer sendiri tanpa login):
[admin]
username = "admin"
password = "ganti-dengan-password"

# atau cukup satu kata sandi:
# app_password = "ganti-dengan-kata-sandi"

[mysql]
host = "localhost"
port = 3306
user = "root"
password = ""
database = "alpukat estate"
